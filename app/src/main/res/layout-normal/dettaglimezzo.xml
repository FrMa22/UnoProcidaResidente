<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColor"
    android:orientation="vertical">

    <Toolbar
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1"
        android:background="@drawable/background_main_title_text_view">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="UnoProcidaResidente"
            android:textSize="24sp"
            android:textStyle="bold" />
    </Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="20dp"
        android:layout_weight="0.9"
        android:background="@drawable/dropdown_background"
        android:orientation="vertical"
        android:padding="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:src="@drawable/background_icon_list_item" />

            <TextView
                android:id="@+id/txtMezzo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/tampone"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textColor="@color/secondaryColor" />
        </RelativeLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="0.5"
                android:gravity="end"
                android:text="@string/text_view_partenza"
                android:textColor="@color/grey"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPartenza"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="0.5"
                android:gravity="start"
                android:text="@string/tampone"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/grey"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="0.5"
                android:gravity="end"
                android:text="@string/text_view_destinazione"
                android:textColor="@color/grey"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtArrivo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="0.5"
                android:gravity="center"
                android:text="@string/tampone"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/grey"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="0.5"
                android:gravity="end"
                android:text="@string/text_view_costo_intero"
                android:textColor="@color/grey"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCostoIntero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="0.5"
                android:gravity="start"
                android:text="@string/tampone"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/grey"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="0.5"
                android:gravity="end"
                android:text="@string/text_view_costo_ridotto"
                android:textColor="@color/grey"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCostoRidotto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="0.5"
                android:gravity="start"
                android:text="@string/tampone"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/grey"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="0.5"
                android:gravity="end"
                android:text="@string/text_view_trasporto_veicoli"
                android:textColor="@color/grey"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAuto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="0.5"
                android:gravity="start"
                android:text="@string/tampone"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/grey"
                android:textSize="14sp" />
        </GridLayout>


        <TextView
            android:id="@+id/txtAllertaMeteo"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/secondaryColor"
            android:text="CondizioniMeteo o Allerta"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/primaryColor" />

        <Button
            android:id="@+id/btnBiglietterie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:text="@string/numeriUtili" />

        <Button
            android:id="@+id/btnTaxi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:text="@string/numeriTaxi" />

        <Button
            android:id="@+id/btnConfermaOSmentisci"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/confermaOSmentisci" />

        <Button
            android:id="@+id/btnReturnToHome"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/esci" />


    </LinearLayout>

</LinearLayout>
